{
  "manifest_version": 3,
  "name": "Polaris LMS PDF Downloader",
  "version": "1.1",
  "permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.polariscampus.com/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://lms.polariscampus.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
